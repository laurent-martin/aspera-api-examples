---
misc:
  platform: osx-arm64
  level: debug
  show_secrets: false
  transfer_regular: true
trsdk:
  url: grpc://127.0.0.1:0
  level: trace
  ascp_level: trace
httpgw:
  url: https://<HTTPGW_HOST>/aspera/http-gwy
web:
  port: 9080
server:
  url: ssh://<SERVER_HOST>:33001
  username: "<USERNAME>"
  password: "<PASSWORD>"
  file_download: "/aspera-test-dir-small/10MB.1"
  folder_upload: "/Upload"
  persist_max: 10
  persist_ms: 100
node:
  url: https://<NODE_HOST>
  verify: false
  username: "<USERNAME>"
  password: "<PASSWORD>"
  folder_upload: "/Upload"
cos:
  endpoint: https://s3.us-south.cloud-object-storage.appdomain.cloud
  bucket: "<BUCKET>"
  key: "<API_KEY>"
  crn: "<CRN>"
  auth: https://iam.cloud.ibm.com/identity/token
coscreds:
  service_credential_file: "<SERVICE_CREDENTIAL_FILE>"
  bucket: "<BUCKET>"
  region: us-south
faspex:
  url: https://<FASPEX_HOST>/aspera/faspex
  verify: true
  username: "<USERNAME>"
  password: "<PASSWORD>"
  adminuser: "<ADMINUSER>"
  adminpass: "<ADMIN_PASSWORD>"
faspex5:
  url: https://<FASPEX5_HOST>/aspera/faspex
  verify: true
  username: john@example.com
  client_id: "<CLIENT_ID>"
  client_secret: "<CLIENT_SECRET>"
  private_key: "<PRIVATE_KEY_FILE>"
  shared_folder_name: Server Files
  shared_folder_file: "/testfiles/aspera-test-dir-small/10MB.1"
shares:
  url: https://<SHARES_HOST>
  verify: true
  username: "<USERNAME>"
  password: "<PASSWORD>"
  folder_upload: ascli_share
aoc:
  org: "<ORG>"
  user_email: john@example.com
  private_key: "<PRIVATE_KEY_FILE>"
  client_id: "<CLIENT_ID>"
  client_secret: "<CLIENT_SECRET>"
  workspace: "<WORKSPACE>"
  shared_inbox: "<SHARED_INBOX>"
local:
  file: "/path/to/a/local/file"
  folder: "/tmp"
