<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- gRPC client stubs generated from the proto file of the Transfer SDK -->
    <Protobuf Include="$(Proto_File)" GrpcServices="Client" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="jose-jwt" Version="5.3.0" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <Target Name="CheckProtoFile" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Proto_File)' == '' Or !Exists('$(Proto_File)')" Text="Property Proto_File must be the path of transferd.proto, e.g.: dotnet build -p:Proto_File=/path/to/transferd.proto" />
  </Target>

</Project>
