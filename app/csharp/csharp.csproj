<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- reproducible restore: resolved versions are recorded in packages.lock.json -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- gRPC client stubs generated from the proto file of the Transfer SDK -->
    <Protobuf Include="$(Proto_File)" GrpcServices="Client" />
  </ItemGroup>
  <ItemGroup>
    <!-- versions are defined in Directory.Packages.props -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="jose-jwt" />
    <PackageReference Include="log4net" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <Target Name="CheckProtoFile" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Proto_File)' == '' Or !Exists('$(Proto_File)')" Text="Property Proto_File must be the path of transferd.proto, e.g.: dotnet build -p:Proto_File=/path/to/transferd.proto" />
  </Target>

</Project>
